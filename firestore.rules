rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    function isOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.enabled == true;
    }
    match /admins/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
    }
    match /accessRequests/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == userId
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.resource.data.keys().hasAll(['email', 'displayName', 'requestedAt'])
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'requestedAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.requestedAt == request.time;
    }
    match /members/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['enabled'])
        && request.resource.data.keys().hasOnly(['enabled'])
        && request.resource.data.enabled is bool
        && (request.auth.uid != userId || request.resource.data.enabled == true);
    }
    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['order'])
        && request.resource.data.order is list;
      match /cards/{cardId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasAll(['id', 'category', 'word', 'phonetic', 'meaning', 'sentenceEn', 'sentenceZh', 'note'])
          && request.resource.data.keys().hasOnly(['id', 'category', 'word', 'phonetic', 'meaning', 'sentenceEn', 'sentenceZh', 'note'])
          && request.resource.data.id == cardId
          && request.resource.data.category is string
          && request.resource.data.word is string && request.resource.data.word.size() > 0
          && request.resource.data.phonetic is string
          && request.resource.data.meaning is string && request.resource.data.meaning.size() > 0
          && request.resource.data.sentenceEn is string && request.resource.data.sentenceEn.size() > 0
          && request.resource.data.sentenceZh is string
          && request.resource.data.note is string;
      }
    }
  }
}
